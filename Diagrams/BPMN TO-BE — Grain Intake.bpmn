<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_ToBe" targetNamespace="http://portfolio.example/grain-intake" exporter="Camunda Modeler" exporterVersion="5.48.0">
  <bpmn:collaboration id="Collaboration_ToBe">
    <bpmn:participant id="Participant_ToBe" name="Елеватор — приймання зерна на зберігання (TO-BE, продукти osnova / smart)" processRef="Process_ToBe" />
    <bpmn:textAnnotation id="Ann_ToBe_0">
      <bpmn:text>FG-01 · osnova.бронь · Fit (усуває ВМ-1)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_ToBe_0" associationDirection="None" sourceRef="T_Book" targetRef="Ann_ToBe_0" />
    <bpmn:textAnnotation id="Ann_ToBe_1">
      <bpmn:text>FG-02 · osnova.поклажедатель · Fit + RFID (ВМ-1, ВМ-2)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_ToBe_1" associationDirection="None" sourceRef="T_Arrive" targetRef="Ann_ToBe_1" />
    <bpmn:textAnnotation id="Ann_ToBe_2">
      <bpmn:text>FG-03 · автоваги клієнта · Інтеграція → US-01 (ВМ-3)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_ToBe_2" associationDirection="None" sourceRef="T_Gross" targetRef="Ann_ToBe_2" />
    <bpmn:textAnnotation id="Ann_ToBe_3">
      <bpmn:text>FG-04 · osnova.предприятие · Налаштування (ВМ-4)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_ToBe_3" associationDirection="None" sourceRef="T_Lab" targetRef="Ann_ToBe_3" />
    <bpmn:textAnnotation id="Ann_ToBe_4">
      <bpmn:text>FG-05, FG-06 · osnova.предприятие (ВМ-5)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_ToBe_4" associationDirection="None" sourceRef="T_Assign" targetRef="Ann_ToBe_4" />
    <bpmn:textAnnotation id="Ann_ToBe_5">
      <bpmn:text>FG-07 · smart.сдау · Fit, блокує змішування (ВМ-5)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_ToBe_5" associationDirection="None" sourceRef="T_Route" targetRef="Ann_ToBe_5" />
    <bpmn:textAnnotation id="Ann_ToBe_6">
      <bpmn:text>FG-13 · е-ТТН · уточнити в ZEO</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_ToBe_6" associationDirection="None" sourceRef="T_Leave" targetRef="Ann_ToBe_6" />
    <bpmn:textAnnotation id="Ann_ToBe_7">
      <bpmn:text>FG-08 Налаштування · FG-09 Gap → US-02 (ВМ-6)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_ToBe_7" associationDirection="None" sourceRef="T_Credit" targetRef="Ann_ToBe_7" />
    <bpmn:textAnnotation id="Ann_ToBe_8">
      <bpmn:text>FG-12 · реєстр і залишки онлайн · Fit (ВМ-7)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_ToBe_8" associationDirection="None" sourceRef="T_Check" targetRef="Ann_ToBe_8" />
    <bpmn:textAnnotation id="Ann_ToBe_9">
      <bpmn:text>FG-10 · BAS клієнта · Інтеграція → US-03</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_ToBe_9" associationDirection="None" sourceRef="T_Export" targetRef="Ann_ToBe_9" />
    <bpmn:textAnnotation id="Ann_ToBe_10">
      <bpmn:text>FG-11 · вага, якість і залікова вага в Telegram · Fit (ВМ-8)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_ToBe_10" associationDirection="None" sourceRef="T_End" targetRef="Ann_ToBe_10" />
    <bpmn:textAnnotation id="Ann_ToBe_11">
      <bpmn:text>FG-15 · smart.сдау + модуль сушарок · Fit, дод. модуль (ВМ-9)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_ToBe_11" associationDirection="None" sourceRef="T_Dry" targetRef="Ann_ToBe_11" />
    <bpmn:textAnnotation id="Ann_ToBe_12">
      <bpmn:text>FG-16 · smart.термометрія стежить за нагрівом · Fit</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_ToBe_12" associationDirection="None" sourceRef="T_Vent" targetRef="Ann_ToBe_12" />
    <bpmn:textAnnotation id="Ann_ToBe_13">
      <bpmn:text>FG-17 · планування знезараження в osnova · уточнити в ZEO</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_ToBe_13" associationDirection="None" sourceRef="T_Fumig" targetRef="Ann_ToBe_13" />
    <bpmn:textAnnotation id="Ann_ToBe_Legend">
      <bpmn:text>Типи задач: рука — вручну, без системи; людина — людина працює в системі; шестерня — виконує система автоматично.
FG-NN — рядок Fit-Gap матриці (розділ 5 кейсу): чим саме продукт osnova / smart закриває потребу клієнта.
Fit — є в продукті з коробки.   Налаштування — довідники, норми, ролі без програмування.   Інтеграція — обмін з обладнанням чи системами клієнта (ваги, BAS).   Gap — доробка під клієнта.
US-NN — User Story для розробки (пишемо лише на Інтеграцію та Gap).   ВМ-N — вузьке місце з AS-IS, яке усуває цей крок.
Складський документ оформлюється на партію, окремим процесом; реєстрація в держреєстрі складських документів — FG-14, уточнити в ZEO.
Вологість — групи за Техрегламентом зернового складу (п. 6.9.4): середньої сухості 13,5–15,5%, вологе 15,5–17%, сире понад 17%. Базис 14% — приклад для кукурудзи. Межу між вентилюванням і сушінням узято як межу групи «сире»; конкретну межу встановлює технолог.
Далі — зберігання, окремий процес: термопідвіски в силосі стежать за температурою; якщо зерно гріється — вентилюють або перекачують у інший силос.
Схема — приймання на зберігання (поклажодавець). При закупівлі зерна елеватором кроки ті самі, але замість складського документа — документи купівлі-продажу, а оплата йде за заліковою вагою.</bpmn:text>
    </bpmn:textAnnotation>
  </bpmn:collaboration>
  <bpmn:process id="Process_ToBe" isExecutable="false">
    <bpmn:laneSet id="LaneSet_ToBe">
      <bpmn:lane id="Lane_ToBe_7" name="Силосний корпус">
        <bpmn:flowNodeRef>T_Vent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Fumig</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ToBe_6" name="Оператор SCADA">
        <bpmn:flowNodeRef>T_Route</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Moist</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_M</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Store</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_M2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Infest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_M3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Stored</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ToBe_5" name="Доробка (сепаратор, сушарка)">
        <bpmn:flowNodeRef>T_Clean</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Buffer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Dry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Measure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_DryOk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Clean2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ToBe_4" name="Бухгалтерія">
        <bpmn:flowNodeRef>T_Check</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ToBe_3" name="Вагова">
        <bpmn:flowNodeRef>T_Gross</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Tare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Fork2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ToBe_2" name="Лабораторія">
        <bpmn:flowNodeRef>T_Sample</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Lab</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ToBe_1" name="Система osnova">
        <bpmn:flowNodeRef>T_Quota</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_QOk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Credit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Export</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_End</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ToBe_0" name="Водій / поклажодавець">
        <bpmn:flowNodeRef>T_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Book</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Arrive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ToSampler</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Unload</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ToScale</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Leave</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Left</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="T_Start" name="Потрібно здати зерно">
      <bpmn:outgoing>TF1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="T_Book" name="Забронювати тайм-слот у Telegram-боті">
      <bpmn:incoming>TF1</bpmn:incoming>
      <bpmn:outgoing>TF2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="T_Quota" name="Перевірити квоту, підтвердити бронь, нагадати водію">
      <bpmn:incoming>TF2</bpmn:incoming>
      <bpmn:outgoing>TF3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="T_Arrive" name="Заїхати у свій слот, отримати RFID-мітку, стати на ваги">
      <bpmn:incoming>TF3</bpmn:incoming>
      <bpmn:outgoing>TF4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="T_Gross" name="Зважити брутто — вага й номер надходять автоматично">
      <bpmn:incoming>TF4</bpmn:incoming>
      <bpmn:outgoing>TF5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:manualTask id="T_ToSampler" name="Під&#39;їхати до пробовідбірника">
      <bpmn:incoming>TF5</bpmn:incoming>
      <bpmn:outgoing>TF6</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="T_Sample" name="Відібрати пробу з кузова">
      <bpmn:incoming>TF6</bpmn:incoming>
      <bpmn:outgoing>TF7</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="T_Lab" name="Аналіз (вологість, домішки, натура, зараженість) — у систему">
      <bpmn:incoming>TF7</bpmn:incoming>
      <bpmn:outgoing>TF8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="T_QOk" name="Якість у межах договору?">
      <bpmn:incoming>TF8</bpmn:incoming>
      <bpmn:outgoing>TF10</bpmn:outgoing>
      <bpmn:outgoing>TF11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="T_Reject" name="Відмова з причиною в Telegram">
      <bpmn:incoming>TF10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="T_Assign" name="Призначити яму, доробку і силос за якістю та планом; заражене — окремо">
      <bpmn:incoming>TF11</bpmn:incoming>
      <bpmn:outgoing>TF12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="T_Route" name="Запустити маршрут у smart.сдау">
      <bpmn:incoming>TF12</bpmn:incoming>
      <bpmn:outgoing>TF13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="T_Unload" name="Розвантажитися в призначену яму">
      <bpmn:incoming>TF13</bpmn:incoming>
      <bpmn:outgoing>TF13b</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:parallelGateway id="T_Split" name="">
      <bpmn:incoming>TF13b</bpmn:incoming>
      <bpmn:outgoing>TF14</bpmn:outgoing>
      <bpmn:outgoing>TG1</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:manualTask id="T_ToScale" name="Заїхати на ваги — RFID фіксує маршрут">
      <bpmn:incoming>TF14</bpmn:incoming>
      <bpmn:outgoing>TF14b</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:serviceTask id="T_Tare" name="Зважити тару — нетто рахується автоматично">
      <bpmn:incoming>TF14b</bpmn:incoming>
      <bpmn:outgoing>TF15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="T_Fork2" name="">
      <bpmn:incoming>TF15</bpmn:incoming>
      <bpmn:outgoing>TF16</bpmn:outgoing>
      <bpmn:outgoing>TF18</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_Leave" name="Отримати ТТН або е-ТТН з відміткою, виїхати">
      <bpmn:incoming>TF16</bpmn:incoming>
      <bpmn:outgoing>TF17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="T_Left" name="Авто виїхало">
      <bpmn:incoming>TF17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="T_Credit" name="Розрахувати залікову вагу, додати в реєстр поклажодавця">
      <bpmn:incoming>TF18</bpmn:incoming>
      <bpmn:outgoing>TF19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="T_Check" name="Перевірити розрахунок">
      <bpmn:incoming>TF19</bpmn:incoming>
      <bpmn:outgoing>TF20</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="T_Export" name="Передати дані в BAS, сповістити поклажодавця">
      <bpmn:incoming>TF20</bpmn:incoming>
      <bpmn:outgoing>TF21</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="T_End" name="Машину враховано, поклажодавець має результат">
      <bpmn:incoming>TF21</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="T_Clean" name="Попереднє очищення, вага відходів — у систему">
      <bpmn:incoming>TG1</bpmn:incoming>
      <bpmn:outgoing>TG2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="T_Moist" name="Вологість за аналізом (базис 14%)?">
      <bpmn:incoming>TG2</bpmn:incoming>
      <bpmn:outgoing>TG3</bpmn:outgoing>
      <bpmn:outgoing>TG4</bpmn:outgoing>
      <bpmn:outgoing>TG5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_Buffer" name="Накопичити в буферному силосі сирого зерна">
      <bpmn:incoming>TG3</bpmn:incoming>
      <bpmn:outgoing>TG6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_Dry" name="Просушити — режим за вологістю партії">
      <bpmn:incoming>TG6</bpmn:incoming>
      <bpmn:incoming>TG8</bpmn:incoming>
      <bpmn:outgoing>TG6b</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="T_Measure" name="Виміряти вологість на виході сушарки — дані в систему">
      <bpmn:incoming>TG6b</bpmn:incoming>
      <bpmn:outgoing>TG7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="T_DryOk" name="Вологість на виході ≤ 14%?">
      <bpmn:incoming>TG7</bpmn:incoming>
      <bpmn:outgoing>TG8</bpmn:outgoing>
      <bpmn:outgoing>TG9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_Vent" name="Подати в силос з аерацією, увімкнути вентилювання">
      <bpmn:incoming>TG5</bpmn:incoming>
      <bpmn:outgoing>TG10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_Clean2" name="Вторинне очищення після сушіння">
      <bpmn:incoming>TG9</bpmn:incoming>
      <bpmn:outgoing>TG9b</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="T_M" name="">
      <bpmn:incoming>TG4</bpmn:incoming>
      <bpmn:incoming>TG9b</bpmn:incoming>
      <bpmn:outgoing>TG11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_Store" name="Подати зерно в призначений силос">
      <bpmn:incoming>TG11</bpmn:incoming>
      <bpmn:outgoing>TG11b</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="T_M2" name="">
      <bpmn:incoming>TG10</bpmn:incoming>
      <bpmn:incoming>TG11b</bpmn:incoming>
      <bpmn:outgoing>TG12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="T_Infest" name="Заражено шкідниками?">
      <bpmn:incoming>TG12</bpmn:incoming>
      <bpmn:outgoing>TG13</bpmn:outgoing>
      <bpmn:outgoing>TG14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_Fumig" name="Запланувати знезараження, силос поза обігом на час дегазації">
      <bpmn:incoming>TG13</bpmn:incoming>
      <bpmn:outgoing>TG15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="T_M3" name="">
      <bpmn:incoming>TG14</bpmn:incoming>
      <bpmn:incoming>TG15</bpmn:incoming>
      <bpmn:outgoing>TG16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="T_Stored" name="Зерно в силосі">
      <bpmn:incoming>TG16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="TF1" sourceRef="T_Start" targetRef="T_Book" />
    <bpmn:sequenceFlow id="TF2" sourceRef="T_Book" targetRef="T_Quota" />
    <bpmn:sequenceFlow id="TF3" sourceRef="T_Quota" targetRef="T_Arrive" />
    <bpmn:sequenceFlow id="TF4" sourceRef="T_Arrive" targetRef="T_Gross" />
    <bpmn:sequenceFlow id="TF5" sourceRef="T_Gross" targetRef="T_ToSampler" />
    <bpmn:sequenceFlow id="TF6" sourceRef="T_ToSampler" targetRef="T_Sample" />
    <bpmn:sequenceFlow id="TF7" sourceRef="T_Sample" targetRef="T_Lab" />
    <bpmn:sequenceFlow id="TF8" sourceRef="T_Lab" targetRef="T_QOk" />
    <bpmn:sequenceFlow id="TF10" name="ні" sourceRef="T_QOk" targetRef="T_Reject" />
    <bpmn:sequenceFlow id="TF11" name="так" sourceRef="T_QOk" targetRef="T_Assign" />
    <bpmn:sequenceFlow id="TF12" sourceRef="T_Assign" targetRef="T_Route" />
