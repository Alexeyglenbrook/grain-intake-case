<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_AsIs" targetNamespace="http://portfolio.example/grain-intake" exporter="Camunda Modeler" exporterVersion="5.48.0">
  <bpmn:collaboration id="Collaboration_AsIs">
    <bpmn:participant id="Participant_AsIs" name="Елеватор — приймання зерна на зберігання (AS-IS)" processRef="Process_AsIs" />
    <bpmn:textAnnotation id="Ann_AsIs_0">
      <bpmn:text>ВМ-1: черга без запису — у сезон авто стоять годинами</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_AsIs_0" associationDirection="None" sourceRef="A_Queue" targetRef="Ann_AsIs_0" />
    <bpmn:textAnnotation id="Ann_AsIs_1">
      <bpmn:text>ВМ-2: паперовий журнал — немає даних, хто і коли заїхав</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_AsIs_1" associationDirection="None" sourceRef="A_Gate" targetRef="Ann_AsIs_1" />
    <bpmn:textAnnotation id="Ann_AsIs_2">
      <bpmn:text>ВМ-3: номер і вагу вводять вручну — помилки й зловживання</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_AsIs_2" associationDirection="None" sourceRef="A_Gross" targetRef="Ann_AsIs_2" />
    <bpmn:textAnnotation id="Ann_AsIs_3">
      <bpmn:text>ВМ-4: результат аналізу йде папером — авто чекає</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_AsIs_3" associationDirection="None" sourceRef="A_GetResult" targetRef="Ann_AsIs_3" />
    <bpmn:textAnnotation id="Ann_AsIs_4">
      <bpmn:text>ВМ-5: силос обирають з пам'яті — ризик змішування культур і класів</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_AsIs_4" associationDirection="None" sourceRef="A_Silo" targetRef="Ann_AsIs_4" />
    <bpmn:textAnnotation id="Ann_AsIs_5">
      <bpmn:text>ВМ-6: ручний розрахунок — помилки й спори з поклажодавцем</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_AsIs_5" associationDirection="None" sourceRef="A_Credit" targetRef="Ann_AsIs_5" />
    <bpmn:textAnnotation id="Ann_AsIs_6">
      <bpmn:text>ВМ-7: реєстр і залишки — вручну, розбіжності на інвентаризації</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_AsIs_6" associationDirection="None" sourceRef="A_Registry" targetRef="Ann_AsIs_6" />
    <bpmn:textAnnotation id="Ann_AsIs_7">
      <bpmn:text>ВМ-8: водій їде без залікової ваги — поклажодавець потім дзвонить</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_AsIs_7" associationDirection="None" sourceRef="A_Leave" targetRef="Ann_AsIs_7" />
    <bpmn:textAnnotation id="Ann_AsIs_8">
      <bpmn:text>ВМ-9: режим сушіння на око — пересушка або недосушка</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_AsIs_8" associationDirection="None" sourceRef="A_Dry" targetRef="Ann_AsIs_8" />
    <bpmn:textAnnotation id="Ann_AsIs_Legend">
      <bpmn:text>Типи задач: рука — вручну, без системи; людина — людина працює в системі; шестерня — виконує система автоматично.
ВМ-N — вузьке місце: крок, де елеватор втрачає час, гроші або якість зерна. Номери збігаються з таблицею в розділі 3 кейсу.
Після розвантаження процес ділиться: авто йде на ваги і виїжджає, а зерно — через доробку в силос. Маршрут доробки визначено аналізом лабораторії ще до розвантаження; розвилка його лише виконує.
Складський документ (квитанція або свідоцтво) оформлюється не на кожне авто, а на партію — на підставі реєстру поклажодавця. Це окремий процес.
Вологість — групи за Техрегламентом зернового складу (п. 6.9.4): середньої сухості 13,5–15,5%, вологе 15,5–17%, сире понад 17%. Базис 14% — приклад для кукурудзи. Межу між вентилюванням і сушінням узято як межу групи «сире»; конкретну межу встановлює технолог.
Далі — зберігання, окремий процес: термопідвіски в силосі стежать за температурою; якщо зерно гріється — вентилюють або перекачують у інший силос.
Схема — приймання на зберігання (поклажодавець). При закупівлі зерна елеватором кроки ті самі, але замість складського документа — документи купівлі-продажу, а оплата йде за заліковою вагою.</bpmn:text>
    </bpmn:textAnnotation>
  </bpmn:collaboration>
  <bpmn:process id="Process_AsIs" isExecutable="false">
    <bpmn:laneSet id="LaneSet_AsIs">
      <bpmn:lane id="Lane_AsIs_7" name="Силосний корпус">
        <bpmn:flowNodeRef>A_Vent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Fumig</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_AsIs_6" name="Оператор приймання">
        <bpmn:flowNodeRef>A_GetResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Silo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Moist</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_M</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Store</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_M2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Infest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_M3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Stored</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_AsIs_5" name="Доробка (сепаратор, сушарка)">
        <bpmn:flowNodeRef>A_Clean</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Buffer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Dry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Measure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_DryOk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Clean2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_AsIs_4" name="Бухгалтерія / комірник">
        <bpmn:flowNodeRef>A_Credit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Registry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_End</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_AsIs_3" name="Вагова">
        <bpmn:flowNodeRef>A_Gross</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Tare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Fork2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_AsIs_2" name="Лабораторія">
        <bpmn:flowNodeRef>A_Sample</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Analyze</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_QOk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Reject</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_AsIs_1" name="КПП (охорона)">
        <bpmn:flowNodeRef>A_Gate</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_AsIs_0" name="Водій / поклажодавець">
        <bpmn:flowNodeRef>A_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Queue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_ToGross</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_ToSampler</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Unload</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_ToScale</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Leave</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Left</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="A_Start" name="Авто із зерном прибуло">
      <bpmn:outgoing>AF1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:manualTask id="A_Queue" name="Чекати в черзі біля воріт">
      <bpmn:incoming>AF1</bpmn:incoming>
      <bpmn:outgoing>AF2</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="A_Gate" name="Перевірити ТТН, записати авто в паперовий журнал">
      <bpmn:incoming>AF2</bpmn:incoming>
      <bpmn:outgoing>AF3</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="A_ToGross" name="Заїхати на ваги на в&#39;їзді">
      <bpmn:incoming>AF3</bpmn:incoming>
      <bpmn:outgoing>AF4</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="A_Gross" name="Зважити брутто, вручну ввести номер і вагу">
      <bpmn:incoming>AF4</bpmn:incoming>
      <bpmn:outgoing>AF5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="A_ToSampler" name="Під&#39;їхати до пробовідбірника">
      <bpmn:incoming>AF5</bpmn:incoming>
      <bpmn:outgoing>AF6</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="A_Sample" name="Відібрати пробу з кузова">
      <bpmn:incoming>AF6</bpmn:incoming>
      <bpmn:outgoing>AF7</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="A_Analyze" name="Аналіз: вологість, домішки, натура, зараженість, клас">
      <bpmn:incoming>AF7</bpmn:incoming>
      <bpmn:outgoing>AF8</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="A_QOk" name="Зерно в межах умов договору?">
      <bpmn:incoming>AF8</bpmn:incoming>
      <bpmn:outgoing>AF10</bpmn:outgoing>
      <bpmn:outgoing>AF11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="A_Reject" name="Відмова, авто виїжджає">
      <bpmn:incoming>AF10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:manualTask id="A_GetResult" name="Отримати результат аналізу на папері / телефоном">
      <bpmn:incoming>AF11</bpmn:incoming>
      <bpmn:outgoing>AF12</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="A_Silo" name="Обрати яму, доробку і силос «з пам&#39;яті»; заражене — окремо">
      <bpmn:incoming>AF12</bpmn:incoming>
      <bpmn:outgoing>AF13</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="A_Unload" name="Розвантажити в завальну яму">
      <bpmn:incoming>AF13</bpmn:incoming>
      <bpmn:outgoing>AF13b</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:parallelGateway id="A_Split" name="">
      <bpmn:incoming>AF13b</bpmn:incoming>
      <bpmn:outgoing>AF14</bpmn:outgoing>
      <bpmn:outgoing>AG1</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:manualTask id="A_ToScale" name="Заїхати на ваги для зважування тари">
      <bpmn:incoming>AF14</bpmn:incoming>
      <bpmn:outgoing>AF14b</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="A_Tare" name="Зважити тару, порахувати нетто, підписати ТТН">
      <bpmn:incoming>AF14b</bpmn:incoming>
      <bpmn:outgoing>AF15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="A_Fork2" name="">
      <bpmn:incoming>AF15</bpmn:incoming>
      <bpmn:outgoing>AF16</bpmn:outgoing>
      <bpmn:outgoing>AF18</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:manualTask id="A_Leave" name="Забрати примірник ТТН перевізника, виїхати">
      <bpmn:incoming>AF16</bpmn:incoming>
      <bpmn:outgoing>AF17</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="A_Left" name="Авто виїхало">
      <bpmn:incoming>AF17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="A_Credit" name="Порахувати залікову вагу в Excel (формула Дюваля)">
      <bpmn:incoming>AF18</bpmn:incoming>
      <bpmn:outgoing>AF19</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="A_Registry" name="Внести в реєстр поклажодавця і журнал залишків">
      <bpmn:incoming>AF19</bpmn:incoming>
      <bpmn:outgoing>AF20</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="A_End" name="Машину враховано в реєстрі">
      <bpmn:incoming>AF20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:manualTask id="A_Clean" name="Попереднє очищення на сепараторі, зважити відходи">
      <bpmn:incoming>AG1</bpmn:incoming>
      <bpmn:outgoing>AG2</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="A_Moist" name="Вологість за аналізом (базис 14%)?">
      <bpmn:incoming>AG2</bpmn:incoming>
      <bpmn:outgoing>AG3</bpmn:outgoing>
      <bpmn:outgoing>AG4</bpmn:outgoing>
      <bpmn:outgoing>AG5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="A_Buffer" name="Накопичити в буферному силосі сирого зерна">
      <bpmn:incoming>AG3</bpmn:incoming>
      <bpmn:outgoing>AG6</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="A_Dry" name="Просушити на зерносушарці, режим «на око»">
      <bpmn:incoming>AG6</bpmn:incoming>
      <bpmn:incoming>AG8</bpmn:incoming>
      <bpmn:outgoing>AG6b</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="A_Measure" name="Відібрати пробу на виході сушарки, віднести в лабораторію">
      <bpmn:incoming>AG6b</bpmn:incoming>
      <bpmn:outgoing>AG7</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="A_DryOk" name="Вологість на виході ≤ 14%?">
      <bpmn:incoming>AG7</bpmn:incoming>
      <bpmn:outgoing>AG8</bpmn:outgoing>
      <bpmn:outgoing>AG9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="A_Vent" name="Подати в силос з аерацією, увімкнути вентилювання">
      <bpmn:incoming>AG5</bpmn:incoming>
      <bpmn:outgoing>AG10</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="A_Clean2" name="Вторинне очищення після сушіння">
      <bpmn:incoming>AG9</bpmn:incoming>
      <bpmn:outgoing>AG9b</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="A_M" name="">
      <bpmn:incoming>AG4</bpmn:incoming>
      <bpmn:incoming>AG9b</bpmn:incoming>
      <bpmn:outgoing>AG11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="A_Store" name="Подати зерно в силос">
      <bpmn:incoming>AG11</bpmn:incoming>
      <bpmn:outgoing>AG11b</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="A_M2" name="">
      <bpmn:incoming>AG10</bpmn:incoming>
      <bpmn:incoming>AG11b</bpmn:incoming>
      <bpmn:outgoing>AG12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="A_Infest" name="Заражено шкідниками?">
      <bpmn:incoming>AG12</bpmn:incoming>
      <bpmn:outgoing>AG13</bpmn:outgoing>
      <bpmn:outgoing>AG14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="A_Fumig" name="Запланувати знезараження силосу (послуга за договором)">
      <bpmn:incoming>AG13</bpmn:incoming>
      <bpmn:outgoing>AG15</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="A_M3" name="">
      <bpmn:incoming>AG14</bpmn:incoming>
      <bpmn:incoming>AG15</bpmn:incoming>
      <bpmn:outgoing>AG16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="A_Stored" name="Зерно в силосі">
      <bpmn:incoming>AG16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="AF1" sourceRef="A_Start" targetRef="A_Queue" />
    <bpmn:sequenceFlow id="AF2" sourceRef="A_Queue" targetRef="A_Gate" />
    <bpmn:sequenceFlow id="AF3" sourceRef="A_Gate" targetRef="A_ToGross" />
    <bpmn:sequenceFlow id="AF4" sourceRef="A_ToGross" targetRef="A_Gross" />
    <bpmn:sequenceFlow id="AF5" sourceRef="A_Gross" targetRef="A_ToSampler" />
    <bpmn:sequenceFlow id="AF6" sourceRef="A_ToSampler" targetRef="A_Sample" />
    <bpmn:sequenceFlow id="AF7" sourceRef="A_Sample" targetRef="A_Analyze" />
    <bpmn:sequenceFlow id="AF8" sourceRef="A_Analyze" targetRef="A_QOk" />
    <bpmn:sequenceFlow id="AF10" name="ні" sourceRef="A_QOk" targetRef="A_Reject" />
    <bpmn:sequenceFlow id="AF11" name="так" sourceRef="A_QOk" targetRef="A_GetResult" />
    <bpmn:sequenceFlow id="AF12" sourceRef="A_GetResult" targetRef="A_Silo" />
    <bpmn:sequenceFlow id="AF13" sourceRef="A_Silo" targetRef="A_Unload" />
    <bpmn:sequenceFlow id="AF13b" sourceRef="A_Unload" targetRef="A_Split" />
    <bpmn:sequenceFlow id="AF14" sourceRef="A_Split" targetRef="A_ToScale" />
    <bpmn:sequenceFlow id="AG1" sourceRef="A_Split" targetRef="A_Clean" />
    <bpmn:sequenceFlow id="AF14b" sourceRef="A_ToScale" targetRef="A_Tare" />
    <bpmn:sequenceFlow id="AF15" sourceRef="A_Tare" targetRef="A_Fork2" />
    <bpmn:sequenceFlow id="AF16" sourceRef="A_Fork2" targetRef="A_Leave" />
    <bpmn:sequenceFlow id="AF18" sourceRef="A_Fork2" targetRef="A_Credit" />
    <bpmn:sequenceFlow id="AF17" sourceRef="A_Leave" targetRef="A_Left" />
    <bpmn:sequenceFlow id="AF19" sourceRef="A_Credit" targetRef="A_Registry" />
    <bpmn:sequenceFlow id="AF20" sourceRef="A_Registry" targetRef="A_End" />
    <bpmn:sequenceFlow id="AG2" sourceRef="A_Clean" targetRef="A_Moist" />
    <bpmn:sequenceFlow id="AG3" name="&#62; 17% (сире) — сушіння" sourceRef="A_Moist" targetRef="A_Buffer" />
    <bpmn:sequenceFlow id="AG4" name="≤ 14% — без доробки" sourceRef="A_Moist" targetRef="A_M" />
    <bpmn:sequenceFlow id="AG5" name="&#62; 14%, ≤ 17% — вентилювання" sourceRef="A_Moist" targetRef="A_Vent" />
    <bpmn:sequenceFlow id="AG6" sourceRef="A_Buffer" targetRef="A_Dry" />
    <bpmn:sequenceFlow id="AG8" name="ні — ще прохід" sourceRef="A_DryOk" targetRef="A_Dry" />
    <bpmn:sequenceFlow id="AG6b" sourceRef="A_Dry" targetRef="A_Measure" />
    <bpmn:sequenceFlow id="AG7" sourceRef="A_Measure" targetRef="A_DryOk" />
    <bpmn:sequenceFlow id="AG9" name="так" sourceRef="A_DryOk" targetRef="A_Clean2" />
